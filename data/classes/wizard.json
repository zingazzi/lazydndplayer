  "level_progression": [
    {
      "level": 1,
      "proficiency_bonus": 2,
      "features": [
        {
          "name": "Spellcasting",
          "description": "As a student of arcane magic, you have a spellbook containing spells that show the first glimmerings of your true power. Intelligence is your spellcasting ability for your wizard spells. You know 3 cantrips and start with 6 1st-level spells in your spellbook.",
          "uses_formula": "0",
          "rest_type": "None",
          "mechanics": {
            "type": "spellcasting",
            "initial_cantrips": 3,
            "initial_spells": 6,
            "spells_per_level": 2
          }
        },
        {
          "name": "Ritual Adept",
          "description": "You can cast any wizard spell in your spellbook as a ritual if that spell has the ritual tag. You don't need to have the spell prepared.",
          "uses_formula": "0",
          "rest_type": "None"
        },
        {
          "name": "Arcane Recovery",
          "description": "Once per long rest, you can regain some magical energy by studying your spellbook. You can recover expended spell slots with a combined level equal to or less than half your wizard level (rounded up). None of the slots can be 6th level or higher.",
          "uses_formula": "1",
          "rest_type": "Long Rest"
        }
      ],
